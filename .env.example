# Copy this to .env and fill in your values.
# Never commit .env to git.

# Required: API authentication key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
NAVDRIFT_API_KEY=your_secret_key_here

# Model paths
ONNX_PATH=./checkpoints/onnx/drift_former_int8.onnx
NORM_STATS_PATH=./checkpoints/drift_former/norm_stats.npz

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:7860,https://your-space.hf.space

# IMU configuration
WINDOW=200
IMU_HZ=100.0

# Set to "true" for demo/development mode (generates ephemeral key if none set)
DEMO_MODE=false

# Weights & Biases (optional, free tier)
WANDB_API_KEY=
